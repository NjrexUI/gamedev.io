{
    "version": 2,
    "builds": [
      {
        "src": "backend/main.py",
        "use": "@vercel/python"
      },
      {
        "src": "gamedev-io/next.config.ts",
        "use": "@vercel/next"
      }
    ],
    "routes": [
      { "src": "/api/(.*)", "dest": "backend/main.py" },
      { "src": "/(.*)", "dest": "gamedev-io/src" }
    ]
  }
  